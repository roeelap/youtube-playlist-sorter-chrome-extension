{
  "manifest_version": 3,
  "name": "YouTube Playlist Sorter",
  "version": "1.0.1",
  "description": "Sorts YouTube playlists alphabetically and adds a search bar to the 'Save to playlist' dropdown.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
